DATABASE_URL="postgresql://cerulean:cerulean@localhost:5433/cerulean"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Used by `npm run db:seed` to create/update the first admin account
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Uploads go to local disk unless both Supabase settings below are set.
UPLOAD_DIR="./uploads"
# Supabase Storage for uploads in production (Project Settings → API Keys → secret key).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Email for "forgot password" links (https://resend.com). Without RESEND_API_KEY,
# emails are printed to the server log instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Archivum <onboarding@resend.dev>"
# Public base URL used in emailed links. On Render, RENDER_EXTERNAL_URL is used if this is blank.
APP_URL="http://localhost:3000"
