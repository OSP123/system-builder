generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

/// Lore categories, tuned for 40k worldbuilding. Extend freely.
enum ArticleCategory {
  HISTORY
  FACTION
  CHAPTER
  REGIMENT
  CHARACTER
  LOCATION
  EVENT
  BATTLE
  ARTIFACT
  XENOS
  HERETIC
  RELIGION
  TECHNOLOGY
  OTHER
}

enum CharacterStatus {
  ACTIVE
  DECEASED
  MISSING
  UNKNOWN
}

/// Force Organisation slots, as in the 3rd edition army lists.
enum ForceSlot {
  HQ
  ELITES
  TROOPS
  FAST_ATTACK
  HEAVY_SUPPORT
  TRANSPORT
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String?
  passwordHash      String
  role              Role                 @default(EDITOR)
  createdAt         DateTime             @default(now())
  /// Disabled users cannot sign in; their content stays.
  disabled          Boolean              @default(false)
  /// Sessions issued before this moment are rejected (sign out everywhere on password change).
  passwordChangedAt DateTime?
  resetTokens       PasswordResetToken[]
  worlds            World[]
  media             Media[]
  articles          Article[]
  systems           StarSystem[]
  planets           Planet[]
  characters        Character[]
  units             Unit[]
  narratives        Narrative[]
  regions           Region[]
}

/// A custom setting inside the 40k universe (e.g. Cerulean). Every piece of
/// content belongs to exactly one world so multiple creators can coexist.
model World {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  tagline      String?
  summary      String?      @db.Text
  published    Boolean      @default(false)
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id])
  coverImageId String?
  coverImage   Media?       @relation("WorldCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  articles     Article[]
  systems      StarSystem[]
  characters   Character[]
  units        Unit[]
  narratives   Narrative[]
  media        Media[]      @relation("WorldMedia")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Article {
  id           String          @id @default(cuid())
  worldId      String
  world        World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId     String?
  author       User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug         String
  title        String
  category     ArticleCategory @default(OTHER)
  summary      String?
  body         String          @default("") @db.Text
  tags         String[]        @default([])
  published    Boolean         @default(false)
  coverImageId String?
  coverImage   Media?          @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  systemId     String?
  system       StarSystem?     @relation(fields: [systemId], references: [id], onDelete: SetNull)
  planetId     String?
  planet       Planet?         @relation(fields: [planetId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([worldId, slug])
  @@index([worldId, category])
}

/// A star system. x/y/z are galactic-map coordinates for the future star map.
model StarSystem {
  id              String    @id @default(cuid())
  worldId         String
  world           World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug            String
  name            String
  starType        String?
  segmentum       String?
  description     String?   @db.Text
  x               Float     @default(0)
  y               Float     @default(0)
  z               Float     @default(0)
  published       Boolean   @default(false)
  /// Visual theme for this system's public pages (see src/lib/theme.ts).
  theme           Json?
  backdropImageId String?
  backdropImage   Media?    @relation("SystemBackdrop", fields: [backdropImageId], references: [id], onDelete: SetNull)
  planets         Planet[]
  articles        Article[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([worldId, slug])
}

model Planet {
  id             String      @id @default(cuid())
  systemId       String
  system         StarSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug           String
  name           String
  /// Imperial classification, e.g. "Hive World", "Forge World", "Death World".
  classification String?
  description    String?     @db.Text
  orbitIndex     Int         @default(0)
  population     String?
  titheGrade     String?
  /// Parameters for the future procedural 3D planet renderer (seed, palette,
  /// water level, cloud cover, etc). Schema intentionally left open.
  genParams      Json?
  published      Boolean     @default(false)
  coverImageId   String?
  coverImage     Media?      @relation("PlanetCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  articles       Article[]
  natives        Character[] @relation("CharacterHomeworld")
  regions        Region[]
  narratives     Narrative[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([systemId, slug])
}

model Media {
  id                 String       @id @default(cuid())
  worldId            String?
  world              World?       @relation("WorldMedia", fields: [worldId], references: [id], onDelete: SetNull)
  /// Storage key (filename inside UPLOAD_DIR, or object key once on S3/R2).
  key                String       @unique
  originalName       String
  mimeType           String
  size               Int
  alt                String?
  uploadedById       String
  uploadedBy         User         @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime     @default(now())
  worldCovers        World[]      @relation("WorldCover")
  articleCovers      Article[]    @relation("ArticleCover")
  planetCovers       Planet[]     @relation("PlanetCover")
  systemBackdrops    StarSystem[] @relation("SystemBackdrop")
  characterPortraits Character[]  @relation("CharacterPortrait")
  unitImages         Unit[]       @relation("UnitImage")
  narrativeCovers    Narrative[]  @relation("NarrativeCover")
}

/// A notable person of the world: "Dramatis Personae".
model Character {
  id              String          @id @default(cuid())
  worldId         String
  world           World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId        String?
  author          User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug            String
  name            String
  /// Rank or honorific shown before/under the name, e.g. "Custodian Captain".
  title           String?
  faction         String?
  status          CharacterStatus @default(ACTIVE)
  quote           String?
  quoteSource     String?
  summary         String?
  body            String          @default("") @db.Text
  /// Optional single statline (see src/lib/codex.ts StatProfile).
  profile         Json?
  wargear         String[]        @default([])
  /// [{ name, description }]
  specialRules    Json?
  /// Lower numbers list first; lets the author rank importance.
  sortOrder       Int             @default(0)
  published       Boolean         @default(false)
  portraitImageId String?
  portraitImage   Media?          @relation("CharacterPortrait", fields: [portraitImageId], references: [id], onDelete: SetNull)
  homeworldId     String?
  homeworld       Planet?         @relation("CharacterHomeworld", fields: [homeworldId], references: [id], onDelete: SetNull)
  narratives      Narrative[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([worldId, slug])
  @@index([worldId, sortOrder])
}

/// A custom army list entry.
model Unit {
  id           String    @id @default(cuid())
  worldId      String
  world        World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId     String?
  author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug         String
  name         String
  faction      String?
  slot         ForceSlot @default(TROOPS)
  /// Free text, e.g. "15 pts/model" or "120 pts".
  points       String?
  /// Unit composition, e.g. "The squad consists of 5 to 10 Space Marines."
  squad        String?
  /// [StatProfile]
  profiles     Json      @default("[]")
  wargear      String[]  @default([])
  options      String?   @db.Text
  specialRules Json?
  description  String    @default("") @db.Text
  sortOrder    Int       @default(0)
  published    Boolean   @default(false)
  imageId      String?
  image        Media?    @relation("UnitImage", fields: [imageId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([worldId, slug])
  @@index([worldId, slot, sortOrder])
}

/// A piece of fiction set in the world.
model Narrative {
  id             String      @id @default(cuid())
  worldId        String
  world          World       @relation(fields: [worldId], references: [id], onDelete: Cascade)
  /// Who created the record. Only they (or an admin) may edit or delete it.
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  slug           String
  title          String
  subtitle       String?
  epigraph       String?
  epigraphSource String?
  summary        String?
  body           String      @default("") @db.Text
  published      Boolean     @default(false)
  coverImageId   String?
  coverImage     Media?      @relation("NarrativeCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  planetId       String?
  planet         Planet?     @relation(fields: [planetId], references: [id], onDelete: SetNull)
  characters     Character[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([worldId, slug])
}

/// One-time "forgot password" link. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A named region of a planet, e.g. a theatre of war, placed on its globe.
model Region {
  id        String   @id @default(cuid())
  planetId  String
  planet    Planet   @relation(fields: [planetId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  /// What kind of place this is, e.g. "Theatre of war", "Hive city".
  kind      String?
  summary   String?  @db.Text
  terrain   String?
  /// Position on the planet's globe, in degrees.
  lat       Float    @default(0)
  lng       Float    @default(0)
  /// [{ name, pointsLevel?, shape?, cx?, cy? }]: sub-areas, optionally with an
  /// 800x500 tactical-map polygon ("x,y x,y ...") and label point.
  sectors   Json     @default("[]")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planetId, slug])
}
